apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
  POSTS_DB_USER: posts_user
  POSTS_DB_PASSWORD: CHANGE_ME
  DUMMY_USERNAME: admin@blog.local
  DUMMY_PASSWORD_HASHED: CHANGE_ME
  JWT_SECRET: CHANGE_ME
  REFRESH_TOKEN_SECRET: CHANGE_ME